{
	"name": "marginalia",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.9"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "node --env-file-if-exists=.env.development node_modules/vite/bin/vite.js dev --port 3000",
		"build": "vite build",
		"start": "node .output/server/index.mjs",
		"generate-routes": "tsr generate",
		"typecheck": "tsr generate && tsc --noEmit",
		"lint": "biome check",
		"format": "biome format --write",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:integration": "vitest run --project integration",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx --env-file-if-exists=.env.development src/server/db/migrate-cli.ts",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-query": "5.104.2",
		"@tanstack/react-router": "1.170.44",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.169.1",
		"busboy": "1.6.0",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.4.0",
		"diff": "9.0.0",
		"domhandler": "6.0.1",
		"drizzle-orm": "0.45.4",
		"fast-xml-parser": "5.11.2",
		"htmlparser2": "12.0.0",
		"lucide-react": "^0.577.0",
		"nitro": "3.0.260610-beta",
		"pg": "8.23.1",
		"pg-boss": "12.38.0",
		"pino": "10.4.0",
		"radix-ui": "^1.8.1",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.3.6",
		"yauzl": "3.4.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@playwright/test": "1.64.1",
		"@tanstack/router-cli": "^1.132.0",
		"@testcontainers/postgresql": "12.2.1",
		"@types/busboy": "^1.5.5",
		"@types/node": "^22.10.2",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@types/yauzl": "^3.4.0",
		"@types/yazl": "^3.3.1",
		"@vitejs/plugin-react": "^6.0.1",
		"drizzle-kit": "0.31.11",
		"testcontainers": "12.2.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "5.0.4",
		"yazl": "^3.3.1"
	},
	"packageManager": "pnpm@12.11.2"
}
