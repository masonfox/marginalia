# Copy to .env next to compose.yaml.

# The login password for this instance. Use a long passphrase.
# Leave it empty (or unset) to disable the login: anyone who can reach the
# instance can use it, which is only appropriate on a trusted network or
# behind an authenticating proxy.
# AUTH_PASSWORD=

# Folder of EPUBs to scan (mounted read-only).
MARGINALIA_LIBRARY_DIR=./library

# Host port (bound to 127.0.0.1).
MARGINALIA_PORT=3000

# Database password for the bundled PostgreSQL.
POSTGRES_PASSWORD=change-me

# Image to run; pin a version such as ghcr.io/OWNER/marginalia:0.1.0.
# MARGINALIA_IMAGE=ghcr.io/OWNER/marginalia:latest

# Required even without AI. Generate with: openssl rand -base64 32
# Back this up with the database; losing it means entering provider keys again.
MARGINALIA_SECRET_KEY=

# Add AI providers and choose models in Settings. Global tuning only:
AI_MAX_STEPS=
# Ignored by current Anthropic models (Claude 5.5); leave empty for them.
AI_TEMPERATURE=
# Reasoning effort: none, minimal, low, medium, high, xhigh, or max. Empty uses the model's default.
AI_EFFORT=
# Prompt caching (Anthropic). Default true; set false to turn it off.
AI_PROMPT_CACHE=
# Price overrides for cost estimates, USD per million tokens, as JSON:
#   {"my-model": {"input": 3, "output": 15, "cacheRead": 0.3, "cacheWrite": 3.75}}
AI_PRICES=
# Automatic preprocessing after import (default false).
# Sends whole books to the provider chosen in Settings.
AI_PREPROCESS_AUTO=
