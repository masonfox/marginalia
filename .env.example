# Copy to .env next to compose.yaml.

# The login password for this instance. Use a long passphrase.
# Leave it empty (or unset) to disable the login: anyone who can reach the
# instance can use it, which is only appropriate on a trusted network or
# behind an authenticating proxy.
# AUTH_PASSWORD=

# Folder of EPUBs to scan (mounted read-only).
MARGINALIA_LIBRARY_DIR=./library

# Host port (bound to 127.0.0.1).
MARGINALIA_PORT=3000

# Database password for the bundled PostgreSQL.
POSTGRES_PASSWORD=change-me

# Image to run; pin a version such as ghcr.io/OWNER/marginalia:0.1.0.
# MARGINALIA_IMAGE=ghcr.io/OWNER/marginalia:latest
