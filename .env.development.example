# Local development settings, loaded by `pnpm dev` and `pnpm db:migrate`.
# Copy to .env.development (gitignored) and adjust. Production reads only real
# environment variables; this file is never used there.

# Start a database with:
#   docker run -d --name marginalia-dev-db -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=marginalia -p 5433:5432 pgvector/pgvector:pg17
DATABASE_URL=postgres://postgres:dev@localhost:5433/marginalia

# Uploaded books and covers go here.
MARGINALIA_DATA_DIR=./.dev-data

# Optional: require a login locally.
# AUTH_PASSWORD=

# Optional: folders of EPUBs to scan, comma-separated.
# MARGINALIA_LIBRARY_PATHS=

LOG_LEVEL=info
